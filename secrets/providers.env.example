# Copy to secrets/providers.env or ~/.config/nestplay/providers.env
# Never commit the copy. Nestplay rejects any plan other than free.

TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=
TMDB_PLAN=free

OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
OPENSUBTITLES_PLAN=free
OPENSUBTITLES_DEV_MODE=false
